{
  "name": "railway-empire-workspace",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm run dev:react",
    "dev:react": "pnpm --filter @railway/react-app dev",
    "dev:angular": "pnpm --filter @railway/angular-app start",
    "test": "pnpm --filter @railway/react-app test",
    "build": "pnpm run build:react",
    "build:react": "pnpm --filter @railway/react-app build",
    "build:angular": "pnpm --filter @railway/angular-app build",
    "build:all": "pnpm -r run build",
    "preview": "pnpm --filter @railway/react-app preview"
  },
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.4.2"
  }
}